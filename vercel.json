{
  "buildCommand": "bash scripts/build.sh",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/book/:slug",
      "destination": "/book/[slug]"
    },
    {
      "source": "/auth-callback",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    }
  ],
  "redirects": [
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/early-access",
      "destination": "/auth?signup=true",
      "permanent": false
    }
  ]
}
