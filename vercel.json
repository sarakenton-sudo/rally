{
  "buildCommand": "bash scripts/build.sh",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/auth-callback", "destination": "/app.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" }
  ],
  "redirects": [
    { "source": "/landing", "destination": "/", "permanent": true }
  ]
}
