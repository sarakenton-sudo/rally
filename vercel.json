{
  "buildCommand": "bash scripts/build.sh",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/game/:id",
      "destination": "/game/[id]"
    },
    {
      "source": "/book/:slug",
      "destination": "/book/[slug]"
    },
    {
      "source": "/fan/:code",
      "destination": "/fan/[code]"
    },
    {
      "source": "/coaching/:coachId",
      "destination": "/coaching/[coachId]"
    },
    {
      "source": "/documents/:id",
      "destination": "/documents/[id]"
    },
    {
      "source": "/lesson/:id",
      "destination": "/lesson/[id]"
    },
    {
      "source": "/athlete/:id",
      "destination": "/athlete/[id]"
    },
    {
      "source": "/tournament/:id",
      "destination": "/tournament/[id]"
    },
    {
      "source": "/auth-callback",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    }
  ],
  "redirects": [
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/early-access",
      "destination": "/auth?signup=true",
      "permanent": false
    }
  ]
}
