# Copy to .env.qa (gitignored) and fill in. Use dedicated test accounts, not your real family.
QA_BASE_URL=https://rally-hub.com        # or http://localhost:8081 for the local preview

QA_PARENT_EMAIL=
QA_PARENT_PASSWORD=
QA_COADMIN_EMAIL=                        # co-parent invited by the parent
QA_COADMIN_PASSWORD=
QA_ATHLETE_EMAIL=                        # athlete invited by the parent
QA_ATHLETE_PASSWORD=
QA_COACH_EMAIL=                          # coach-only account
QA_COACH_PASSWORD=
QA_COACH_SLUG=                           # that coach's published booking page, e.g. coach-sam
QA_COACH_IS_PARENT=0                     # 1 if the coach account also has a family

QA_WRITES=0                              # 1 = run tests that add then remove test data
QA_AI=0                                  # 1 = run tests that call the AI reader (costs API credits)
